# 통합 환경 변수 — web / mobile / supabase CLI 모두 본 파일에서 관리한다.
# 실제 값은 `env/.env.local` 에 기입하며 git 에 커밋하지 않는다.
#
# 변수명 중복 사유: Next.js 는 `NEXT_PUBLIC_` 접두사만, Expo 는 `EXPO_PUBLIC_` 접두사만
# 클라이언트 번들에 포함하므로 같은 값(Supabase URL/KEY) 도 두 벌로 작성해야 한다.

# ── Supabase (web 클라이언트) ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Supabase (mobile 클라이언트) ────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Supabase CLI (config.toml 의 env() 보간이 참조) ─────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Web Client
# Authorized redirect URI: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
